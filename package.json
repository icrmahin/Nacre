{
  "name": "nacre",
  "displayName": "Nacre — Dark Theme Collection",
  "description": "Nacre is a dark VS Code theme with an original Signal / Noise core design, nine independently selectable palette flavors, matching manual file icon themes, and optional desktop-accent tinting for Nacre Core.",
  "version": "1.0.3",
  "publisher": "icrmahin",
  "author": "ICRMAHIN",
  "icon": "nacre-theme-icon.png",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Themes"
  ],
  "keywords": [
    "nacre",
    "dark theme",
    "near black",
    "graphite",
    "syntax highlighting",
    "file icons",
    "product icons",
    "developer theme",
    "adaptive accent",
    "gnome",
    "desktop accent",
    "wallpaper accent",
    "system accent",
    "catppuccin",
    "everforest",
    "gruvbox",
    "kanagawa",
    "material theme",
    "nightfox",
    "osaka jade",
    "color theme pack",
    "tokyo night",
    "one dark pro",
    "signal noise",
    "original syntax palette"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Nacre",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-color-theme.json"
      },
      {
        "label": "Nacre Mocha",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-catppuccin-mocha-color-theme.json"
      },
      {
        "label": "Nacre Grove",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-everforest-color-theme.json"
      },
      {
        "label": "Nacre Ember",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-gruvbox-dark-medium-color-theme.json"
      },
      {
        "label": "Nacre Tide",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-kanagawa-wave-color-theme.json"
      },
      {
        "label": "Nacre Abyss",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-material-ocean-color-theme.json"
      },
      {
        "label": "Nacre Nocturne",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-nightfox-color-theme.json"
      },
      {
        "label": "Nacre Jade",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-osaka-jade-color-theme.json"
      },
      {
        "label": "Nacre Dusk",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-tokyo-night-color-theme.json"
      },
      {
        "label": "Nacre Alloy",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-one-dark-pro-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "nacre-file-icons",
        "label": "Nacre File Icons",
        "path": "./themes/nacre-main-file-icons.json"
      },
      {
        "id": "nacre-mocha-icons",
        "label": "Nacre Mocha Icons",
        "path": "./themes/nacre-mocha-file-icons.json"
      },
      {
        "id": "nacre-grove-icons",
        "label": "Nacre Grove Icons",
        "path": "./themes/nacre-grove-file-icons.json"
      },
      {
        "id": "nacre-ember-icons",
        "label": "Nacre Ember Icons",
        "path": "./themes/nacre-ember-file-icons.json"
      },
      {
        "id": "nacre-tide-icons",
        "label": "Nacre Tide Icons",
        "path": "./themes/nacre-tide-file-icons.json"
      },
      {
        "id": "nacre-abyss-icons",
        "label": "Nacre Abyss Icons",
        "path": "./themes/nacre-abyss-file-icons.json"
      },
      {
        "id": "nacre-nocturne-icons",
        "label": "Nacre Nocturne Icons",
        "path": "./themes/nacre-nocturne-file-icons.json"
      },
      {
        "id": "nacre-jade-icons",
        "label": "Nacre Jade Icons",
        "path": "./themes/nacre-jade-file-icons.json"
      },
      {
        "id": "nacre-tokyo-night-icons",
        "label": "Nacre Dusk Icons",
        "path": "./themes/nacre-tokyo-night-file-icons.json"
      },
      {
        "id": "nacre-one-dark-icons",
        "label": "Nacre Alloy Icons",
        "path": "./themes/nacre-one-dark-file-icons.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "nacre-product-icons",
        "label": "Nacre Product Icons",
        "path": "./themes/nacre-product-icons.json"
      }
    ],
    "configuration": {
      "title": "Nacre",
      "properties": {
        "nacre.colorHighlight.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable inline highlighting for hex, RGB, RGBA, HSL and HSLA color values."
        },
        "nacre.systemAccent.enable": {
          "type": "boolean",
          "default": true,
          "description": "Automatically tint Nacre Core workbench and syntax colors only when the active color theme is exactly Nacre. All nine alternative palette flavors keep their own fixed colors. Syntax colors use a restrained 20% blend. Disable to restore the static Nacre Core palette."
        }
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/icrmahin/Nacre.git"
  },
  "homepage": "https://github.com/icrmahin/Nacre",
  "bugs": {
    "url": "https://github.com/icrmahin/Nacre/issues"
  },
  "scripts": {
    "build:icons": "node scripts/build-icon-themes.mjs",
    "prevalidate": "npm run build:icons",
    "validate": "node scripts/validate.mjs",
    "pretest": "npm run build:icons",
    "test": "node --test",
    "vscode:prepublish": "npm run build:icons"
  }
}
