{
  "name": "nacre",
  "displayName": "Nacre — Premium Dark Theme",
  "description": "A refined near-black Visual Studio Code theme with automatic GNOME and KDE accent integration, subtly adaptive syntax colors, custom file icons and product UI icons.",
  "version": "1.0.2",
  "publisher": "icrmahin",
  "author": "ICRMAHIN",
  "icon": "nacre-theme-icon.png",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Themes"
  ],
  "keywords": [
    "nacre",
    "dark theme",
    "near black",
    "graphite",
    "syntax highlighting",
    "file icons",
    "product icons",
    "developer theme",
    "adaptive accent",
    "gnome",
    "desktop accent",
    "wallpaper accent",
    "system accent"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Nacre",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-color-theme.json"
      },
      {
        "label": "Nacre / Catppuccin Mocha",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-catppuccin-mocha-color-theme.json"
      },
      {
        "label": "Nacre / Everforest Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-everforest-color-theme.json"
      },
      {
        "label": "Nacre / Gruvbox Dark Medium",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-gruvbox-dark-medium-color-theme.json"
      },
      {
        "label": "Nacre / Kanagawa Wave",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-kanagawa-wave-color-theme.json"
      },
      {
        "label": "Nacre / Material Ocean",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-material-ocean-color-theme.json"
      },
      {
        "label": "Nacre / Nightfox",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-nightfox-color-theme.json"
      },
      {
        "label": "Nacre / Osaka Jade",
        "uiTheme": "vs-dark",
        "path": "./themes/nacre-osaka-jade-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "nacre-file-icons",
        "label": "Nacre File Icons",
        "path": "./themes/nacre-file-icons.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "nacre-product-icons",
        "label": "Nacre Product Icons",
        "path": "./themes/nacre-product-icons.json"
      }
    ],
    "configuration": {
      "title": "Nacre",
      "properties": {
        "nacre.colorHighlight.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable inline highlighting for hex, RGB, RGBA, HSL and HSLA color values."
        },
        "nacre.systemAccent.enable": {
          "type": "boolean",
          "default": true,
          "description": "Automatically tint workbench and syntax colors only when the main Nacre theme is active. The seven alternative palette themes keep their own fixed colors. Syntax colors use a visible but restrained 20% blend. Disable to restore the original Nacre palette."
        }
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/icrmahin/Nacre.git"
  },
  "homepage": "https://github.com/icrmahin/Nacre",
  "bugs": {
    "url": "https://github.com/icrmahin/Nacre/issues"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test"
  }
}
